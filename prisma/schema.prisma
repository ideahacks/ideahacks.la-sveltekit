// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// for the summer landing page
model Email {
  id    Int    @id @default(autoincrement())
  email String @unique
}

// for the participants' applications
model ApplicationForm {
  // PERSONAL INFO
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String  @unique
  phone     String
  pronouns  String?

  // EDUCATION
  school   String
  major    String
  year     String
  github   String?
  linkedin String?

  // TEAM INFO
  hasTeam   String
  teammate1 String
  teammate2 String
  teammate3 String
  teammate4 String

  // SHORT ANSWER
  q1 String // prior experience
  q2 String // why participate
  q3 String? // idea to hack
  q4 String // has previous hackathon experience
  q5 String? // previous hackathon experience
  q6 String? // parts wish list

  // MISCELLANEOUS
  requiresHousingAssistance String
  shirtSize                 String
  dietaryRestrictions       String
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

model User {
  id Int @id

  @@schema("auth")
}
